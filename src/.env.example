# Copy to `.env` (git-ignored) and fill in for local development.
# Source it before running the backend/frontend — see doc/quickstart.md and doc/guidance.md.

# --- Backend: APIM "AI Gateway" (all three required to build the agent) ---
# AI_MODEL_DEPLOYMENTS is a comma-separated list of selectable chat models the SPA offers; the FIRST entry
# is the default. Optional AGENT_INSTRUCTIONS overrides the built-in default system prompt.
APIM_GATEWAY_ENDPOINT=https://{apim-instance}.azure-api.net
APIM_SUBSCRIPTION_KEY={your-subscription-key}
AI_MODEL_DEPLOYMENTS={deployment-name}
# AGENT_INSTRUCTIONS=You are a helpful AI agent.

# --- Backend: Cosmos DB conversation store (endpoint + key required, else /chat -> 503) ---
COSMOS_ENDPOINT=https://{cosmos-account}.documents.azure.com:443/
COSMOS_KEY={cosmos-key}
COSMOS_DB=agent_db
COSMOS_CONTAINER=conversations

# --- Backend: Azure AI Search RAG through the APIM gateway (all three required for the `Search` tool; optional) ---
# Endpoint is the APIM AI Search API base; the subscription key is the APIM key (reuse APIM_SUBSCRIPTION_KEY).
AI_SEARCH_ENDPOINT=https://{apim-instance}.azure-api.net/search
AI_SEARCH_SUBSCRIPTION_KEY={your-subscription-key}
AI_SEARCH_INDEX=agent-index

# --- Backend: file-attachment ingestion (upload -> Document Intelligence -> chunk -> embed -> index) ---
# Requires the APIM + AI Search settings above plus the two below (else POST /files -> 503).
# Blob/queue/table are accessed with the App Service's managed identity (no account key) — only the account
# name is needed; endpoints are derived. DOCINTEL_ENDPOINT is the APIM gateway ROOT (the DI SDK appends
# /documentintelligence/...). Embeddings + DI reuse APIM_SUBSCRIPTION_KEY.
# Local dev: DefaultAzureCredential uses your `az login` when running `dotnet run`, or a service principal
# via AZURE_CLIENT_ID / AZURE_TENANT_ID / AZURE_CLIENT_SECRET (with the Storage Blob/Queue/Table Data
# Contributor roles). The identity needs those roles on the account for ingestion to work.
STORAGE_ACCOUNT_NAME={account}
STORAGE_CONTAINER=attachments
DOCINTEL_ENDPOINT=https://{apim-instance}.azure-api.net
AI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
MAX_UPLOAD_MB=10
# Async ingestion: POST /files enqueues, an in-process BackgroundService worker consumes. The queue + status
# table live in the same storage account (managed identity covers them); created on first use.
INGESTION_QUEUE=ingestion
INGESTION_STATUS_TABLE=ingestionstatus

# --- Backend: CORS allow-list for the SPA (comma-separated origins the browser calls from) ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend: backend base URL the browser calls directly (no proxy tier) ---
VITE_AGENT_BACKEND_URL=http://localhost:8000
