<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentBackend</RootNamespace>
    <AssemblyName>AgentBackend</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>33d9fe16-00be-451b-b3a8-e4453b9b566d</UserSecretsId>
    <!-- The Azure OpenAI Responses API surface (ResponsesClient, CreateResponseOptions, reasoning options)
         ships behind the OPENAI001 "evaluation only" diagnostic. We depend on it deliberately (reasoning
         summaries are Responses-only), so opt in rather than sprinkle #pragma across the code. -->
    <!-- OPENAI001: preview Responses API types. MAAI001: preview MAF Compaction API (Microsoft.Agents.AI.Compaction). -->
    <NoWarn>$(NoWarn);OPENAI001;MAAI001</NoWarn>
  </PropertyGroup>

  <!-- Microsoft Agent Framework + Azure integrations (pins tracked in MIGRATION_PLAN.md).
       Referenced now so `dotnet restore` is validated in Phase 0; they are wired up in later phases. -->
  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.5.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.13.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.13.0" />
    <PackageReference Include="Microsoft.Agents.AI.CosmosNoSql" Version="1.13.0-preview.260703.1" />
    <PackageReference Include="Azure.AI.OpenAI" Version="2.5.0-beta.1" />
    <PackageReference Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Search.Documents" Version="11.7.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <PackageReference Include="Azure.Storage.Queues" Version="12.22.0" />
    <PackageReference Include="Azure.Data.Tables" Version="12.11.0" />
  </ItemGroup>

</Project>
